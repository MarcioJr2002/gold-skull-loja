# Copie para .env (ou defina no painel do servidor) e ajuste os valores.

# OBRIGATÓRIO em produção: 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
PORT=3000

# Pasta persistente (produtos, senhas, fotos). No Railway o servidor usa
# RAILWAY_VOLUME_MOUNT_PATH sozinho se DATA_DIR estiver vazio.
# DATA_DIR=/data

# Só na primeira execução: senha inicial do admin (senão o servidor sorteia).
# SETUP_ADMIN_PASSWORD=

# Esqueceu a senha do admin: defina, faça deploy, depois APAGUE.
# RESET_ADMIN_PASSWORD=

# Redireciona HTTP para HTTPS, ativa HSTS e cookie "secure".
FORCE_HTTPS=1

# Quantos proxies existem na frente (Nginx = 1). Necessário para o rate limit
# identificar o IP real do visitante.
TRUST_PROXY=1

# Opcional: só estes IPs conseguem abrir /admin e as APIs privadas.
# Ex.: ADMIN_ALLOW_IPS=189.10.20.30,2804:abc::1
ADMIN_ALLOW_IPS=

# Sessão do painel
SESSION_IDLE_MIN=120
SESSION_MAX_HOURS=12

# Limites de requisição (por IP)
LIMIT_LOGIN=12
LIMIT_PUBLIC=400
LIMIT_API=800
LIMIT_WRITE=400
LIMIT_UPLOAD=150

# Logs de auditoria: tamanho antes de rotacionar para backups/
AUDIT_MAX_MB=8

# URL pública do site (links nos e-mails / push). Ex.: https://sua-loja.up.railway.app
# PUBLIC_URL=

# E-mail de pedidos (SMTP). Sem isso a flag de e-mail fica salva, mas nada é enviado.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu@gmail.com
# SMTP_PASS=senha-de-app
# SMTP_FROM="GOLD SKULL <seu@gmail.com>"

# Web Push (opcional). Se vazio, o servidor gera e guarda em db.settings.pushVapid.
# Contato VAPID (obrigatório para iPhone). NÃO use @localhost — a Apple rejeita com 403.
# Pode ser mailto:seu@email.com ou https://seu-dominio.com
# VAPID_SUBJECT=mailto:seu@email.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Alternativas confiáveis no iPhone (estilo Kyte — sem depender de Web Push da Apple):
# 1) ntfy: instale o app ntfy (App Store / Play Store) e assine o tópico no painel.
# NTFY_ENABLED=true
# NTFY_TOPIC=gs-seu-topico-secreto
# NTFY_SERVER=https://ntfy.sh
# 2) WhatsApp via CallMeBot (mande "I allow callmebot to send me messages" para +34 644 66 46 29):
# CALLMEBOT_ENABLED=true
# CALLMEBOT_PHONE=5547999990000
# CALLMEBOT_APIKEY=sua_chave
