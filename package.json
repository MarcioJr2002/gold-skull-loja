{
  "name": "gold-skull",
  "version": "1.1.0",
  "description": "Loja GOLD SKULL — catálogo dinâmico com painel de produtos",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "pages": "node scripts/prepare-pages.js --build",
